<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/transfer_background">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" app:title="@string/transfer_server_settings" app:titleTextColor="@color/transfer_text" app:navigationIcon="@drawable/ic_transfer_back" app:navigationContentDescription="@string/transfer_back" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/transfer_protocol" android:textColor="@color/transfer_muted" />
            <Spinner android:id="@+id/protocolSpinner" android:layout_width="match_parent" android:layout_height="48dp" android:backgroundTint="@color/transfer_border" />
            <TextView android:id="@+id/protocolNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/transfer_muted" android:textSize="12sp" />
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.RuangFoto.Transfer.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="@string/transfer_host" >
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/hostInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textUri" android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.RuangFoto.Transfer.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="@string/transfer_port" >
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/portInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.RuangFoto.Transfer.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="@string/transfer_user" >
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/userInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textNoSuggestions" android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.RuangFoto.Transfer.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="@string/transfer_password" app:endIconMode="password_toggle">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/passwordInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.RuangFoto.Transfer.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="@string/transfer_folder" >
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/folderInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textNoSuggestions" android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/browseFolderButton" style="@style/Widget.RuangFoto.Transfer.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:text="@string/transfer_browse" />
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.RuangFoto.Transfer.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="@string/transfer_fingerprint" android:id="@+id/hostFingerprintLayout">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/hostFingerprintInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textNoSuggestions" android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/trustHostButton" style="@style/Widget.RuangFoto.Transfer.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:text="@string/transfer_verify_host" />
            <com.google.android.material.button.MaterialButton android:id="@+id/timingSettingsButton" style="@style/Widget.RuangFoto.Transfer.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/transfer_timing" />
            <LinearLayout android:id="@+id/timingOptions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/transfer_timing_hint" android:textColor="@color/transfer_muted" android:textSize="12sp" />
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.RuangFoto.Transfer.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="@string/transfer_connect_timeout" >
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/connectTimeoutInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.RuangFoto.Transfer.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="@string/transfer_read_timeout" >
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/readTimeoutInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.RuangFoto.Transfer.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="@string/transfer_retry_delay" >
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/retryDelayInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.RuangFoto.Transfer.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="@string/transfer_max_retry_delay" >
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/maxRetryDelayInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.RuangFoto.Transfer.Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="@string/transfer_max_attempts" >
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/maxAttemptsInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/testConnectionButton" style="@style/Widget.RuangFoto.Transfer.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/transfer_test" />
            <TextView android:id="@+id/serverStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:accessibilityLiveRegion="polite" android:textColor="@color/transfer_muted" android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
    <com.google.android.material.button.MaterialButton android:id="@+id/saveServerButton" style="@style/Widget.RuangFoto.Transfer.Button" android:layout_width="match_parent" android:layout_height="56dp" android:layout_margin="20dp" android:text="@string/transfer_save" />
</LinearLayout>
